# ---------- App ----------
COMPANY_NAME=Lextria Research
FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ---------- Database entry point ----------
# Any SQLAlchemy URL works. SQLite is the default so the project runs immediately.
# PostgreSQL example (install psycopg first):  postgresql+psycopg://user:pass@host:5432/dbname
# MySQL example (install pymysql first):       mysql+pymysql://user:pass@host:3306/dbname
DATABASE_URL=sqlite:///./consultation.db

# ---------- Slots and rules ----------
TIMEZONE=Asia/Kolkata
SLOT_TIMES=10:00,14:00,17:00
SLOT_DURATION_MINUTES=60
# 0=Monday ... 6=Sunday  (Monday to Saturday below)
WORKING_DAYS=0,1,2,3,4,5
MIN_DAYS_AHEAD=1
BOOKING_HORIZON_DAYS=30
HOLD_MINUTES=15
CHANGE_CUTOFF_HOURS=24
MAX_RESCHEDULES=1
DEFAULT_FEE_INR=10000

# ---------- Razorpay ----------
# Leave the keys empty to run in MOCK payment mode (no real money, for local testing).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Google Calendar + Meet (account: info@lextria.in) ----------
# Run scripts/google_auth.py once to get the refresh token. Leave empty to skip calendar/Meet.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# all = Google also emails calendar invites to the client and the assigned employee
GOOGLE_SEND_UPDATES=all

# ---------- Zoho Mail (SMTP) ----------
# Leave SMTP_USERNAME empty to print emails to the console instead of sending.
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_USERNAME=info@lextria.in
SMTP_PASSWORD=
MAIL_FROM=info@lextria.in
MAIL_FROM_NAME=Lextria Research
